{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/format-js.mjs"],
            "statusMessage": "Formatting..."
          }
        ]
      },
       {
        "matcher": "Write|Edit",
        "hooks": [
{
  "type": "command",
  "command": "py",
  "args": [
    "${CLAUDE_PLUGIN_ROOT}/hooks/secret-guard.py"
  ]
}
        ]
      }
    ]
  }
}